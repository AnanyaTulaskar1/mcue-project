MONGO_URI=mongodb://127.0.0.1:27017/mcue-studio
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
HTTPS_ENABLED=false
CORS_ORIGINS=https://localhost:5173,http://localhost:5173,https://127.0.0.1:5173,http://127.0.0.1:5173

# Set these on first launch to create or promote the studio administrator.
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# SMTP is used for client payment request emails and admin password resets.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
