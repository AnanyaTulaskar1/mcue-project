MONGO_URI=mongodb://127.0.0.1:27017/mcue-studio
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
HTTPS_ENABLED=false
CORS_ORIGINS=https://localhost:5173,http://localhost:5173,https://127.0.0.1:5173,http://127.0.0.1:5173

# Set these on first launch to create or promote the studio administrator.
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Recommended for Render (including Free): create an API key at resend.com.
RESEND_API_KEY=
# Use a sender address on a domain verified in Resend, e.g. MCue Studio <billing@example.com>.
EMAIL_FROM=

# Optional SMTP fallback for local development or hosts that allow SMTP egress.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
